    },
    {
      "files": [],
      "order": 1,
      "stage_id": "01_stepanov_determinant",
      "summary": "Auxiliary polynomial and Stepanov determinant construction at the foundation of the multiplicity method.",
      "title": "Stepanov Determinant"
    },
    {
      "files": [],
      "order": 2,
      "stage_id": "02_cm_curve_derivations",
      "summary": "Invariant derivation D with D^p = 0 on a CM curve for inert primes p and p-adic divisibility of theta derivatives.",
      "title": "CM Curve Derivations and p-adic Divisibility"
    },
    {
      "files": [],
      "order": 3,
      "stage_id": "03_quadric_theta_automorphy",
      "summary": "Writing qN = M^k + R via path quadrics and realizing automorphy of N through theta period integrals on the sixfold cover of GL_5.",
      "title": "Quadric Decomposition and Sixfold-Cover Theta Automorphy"
    },
    {
      "files": [],
      "order": 4,
      "stage_id": "04_stepanov_bootstrap",
      "summary": "Establishing W(1_S) >= 0 through a determinant and reinterpreting it as a multiplicity-one Stepanov bootstrap.",
      "title": "Positivity via Stepanov Determinant Bootstrap"
    },
    {
      "files": [],
      "order": 5,
      "stage_id": "05_von_mangoldt_guinand_weil",
      "summary": "Switching definitively to the von Mangoldt function Lambda with the Guinand-Weil sign and variance test-function trick.",
      "title": "Von Mangoldt Switch and Guinand-Weil Variance Test Function"
    },
    {
      "files": [],
      "order": 6,
      "stage_id": "06_zero_free_region_positivity",
      "summary": "Applying W(1_(0,1] + (~X^eta) 1_(0,1/X]) >= 0 to drive the zero-free threshold beyond 1 - eta.",
      "title": "Positivity Inequality for Zero-Free Width"
    },
    {
      "files": [],
      "order": 7,
      "stage_id": "07_ggp_period_determinants",
      "summary": "Constructing determinants for W(.) carrying Gan-Gross-Prasad periods with interlacing and bounded non-interlacing weights.",
      "title": "Determinants for GGP Periods and Interlacing Weights"
    },
    {
      "files": [],
      "order": 8,
      "stage_id": "08_iterated_theta_lifts",
      "summary": "Iterated theta lifts U(X_0) -> U(X_1) -> ... -> U(X_m) between totally definite unitary groups winning multiplicity m around sqrt(X).",
      "title": "Iterated Unitary Theta Lifts"
    },
    {
      "files": [],
      "order": 9,
      "stage_id": "09_lift_norms_and_divisibility",
      "summary": "Norms and levels of iterated lifts and cancellation of order-m terms with divisibility via Chowla-Selberg, Weyl, and Siegel mass formulas.",
      "title": "Norms, Levels, and Chowla-Selberg / Weyl / Siegel Mass Divisibility"
    },
    {
      "files": [],
      "order": 10,
      "stage_id": "10_iterated_lift_divisibility_bound",
      "summary": "Establishing a sufficient lower bound on the divisibility of the m-fold iterated theta lift.",
      "title": "Lower Bound on Iterated Lift Divisibility"
    },
    {
      "files": [],
      "order": 11,
      "stage_id": "11_iwasawa_tower",
      "summary": "Constructing the Iwasawa tower by analogy to pigeonhole arguments over finite field extensions F_{q^n}/F_q.",
      "title": "Iwasawa Tower Pigeonhole Analogy"
    },
    {
      "files": [],
      "order": 12,
      "stage_id": "12_seesaw_bessel_period",
      "summary": "Seesaw identity identifying the period of the iterated lift as a Bessel period independent of the Hecke characters via Rallis.",
      "title": "Seesaw Identity and Rallis Bessel Period"
    },
    {
      "files": [],
      "order": 13,
      "stage_id": "13_bost_slope_inequality",
      "summary": "Applying the Bost slope inequality from Arakelov geometry to bound arithmetic degrees.",
      "title": "Bost Slope Inequality"
    },
    {
      "files": [],
      "order": 14,
      "stage_id": "14_lift_cost_and_division",
      "summary": "Precise accounting of each lift's cost, overcoming the a priori 2/3 barrier through twisting and division.",
      "title": "Lift Cost Accounting and Breaking the 2/3 Barrier"
    },
    {
      "files": [],
      "order": 15,
      "stage_id": "15_hecke_integral_structure",
      "summary": "Gluing an integral structure across Hecke characters to achieve extra averaging and a greatest-common-divisor effect.",
      "title": "Glued Integral Structure Across Hecke Characters"
    },
    {
      "files": [],
      "order": 16,
      "stage_id": "16_relative_trace_formula",
      "summary": "Relative trace formula via sixfold-cover GL_5 automorphy of mu, reducing by Cauchy-Schwarz to projected Poincare series norms and approximate column orthogonality.",
      "title": "Relative Trace Formula and Poincare Series Orthogonality"
    },
    {
      "files": [],
      "order": 17,
      "stage_id": "17_weakened_vandiver",
      "summary": "Handling surviving classes in H^1(O_E[1/ell], Q_ell/Z_ell(-e)) not killed by twisting via a significant weakening of Vandiver.",
      "title": "Cohomology Classes and Weakened Vandiver"
    },
    {
      "files": [],
      "order": 18,
      "stage_id": "18_covolumes_and_congruences",
      "summary": "Computing covolumes, theta series indices, and congruences between iterated lifts and automorphic forms.",
      "title": "Covolumes, Theta Series Index, and Lift Congruences"
    },
    {
      "files": [],
      "order": 19,
      "stage_id": "19_behrend_iwasawa_choice",
      "summary": "Selecting the exact Iwasawa tower parameters using Behrend's construction.",
